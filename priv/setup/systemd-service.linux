[Unit]
Description=Sky Port Core Daemon
After=network.target remote-fs.target
Requires=network.target remote-fs.target

[Service]
# Use simple+foreground. Type=forking with `daemon` hangs in "activating"
# because nodetool/RPC over Erlang distribution is not used for lifecycle.
#
# Each start regenerates a local Erlang cookie (localhost remsh only).
# Stop with SIGTERM (KillSignal below), not `swm stop` over distribution.
#
# SSH tunnel/transfer ports do not need root. Running the whole service as a
# non-root user is a follow-up (see HOWTO/SECURITY.md).
Type=simple
TimeoutStartSec=120
TimeoutStopSec=60
Restart=always
RestartSec=5
EnvironmentFile=/etc/swm.conf
{PARENT_ENV}Environment=HOME=/root
ExecStart=/bin/bash -c 'export SWM_REGENERATE_COOKIE=1; source {ENV} && exec {SCRIPT} foreground'
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
